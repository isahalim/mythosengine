---
// Chat-agent console — a Groq tool-calling assistant over the same
// /console/* service layer every other page here uses
// (src/server/agent/**). Static shell only, same output: "static"
// constraint as every other console page (see index.astro's header
// comment) — the session sidebar and message thread are built at runtime
// by src/console/scripts/chat.ts against the real API, never baked in.
//
// Restyled 2026-08-28 (later) toward an actual ChatGPT-pattern layout —
// docs/DECISIONS.md — the mono/all-caps treatment used here originally
// read as a terminal, not the "ChatGPT-style prompting place" asked for.
import ConsoleLayout from "../../layouts/ConsoleLayout.astro";
import ConsoleShell from "../../console/components/ConsoleShell.astro";
import { PromptInputBox } from "../../console/components/PromptInputBox.tsx";
---

<ConsoleLayout title="Chat">
  <ConsoleShell active="chat" />

  <main class="mx-auto flex h-[calc(100vh-5.5rem)] max-w-6xl flex-col gap-4 px-6 pb-6">
    <div class="flex min-h-0 flex-1 flex-col gap-4 md:flex-row">
      <aside class="glass-card flex max-h-40 shrink-0 flex-col gap-1 p-3 md:w-72 md:max-h-none">
        <button
          id="chat-new-session"
          type="button"
          class="mb-2 flex items-center gap-2 rounded-xl border border-mercury/15 px-3 py-2.5 font-body text-sm text-bone transition-colors hover:border-sodium/40 hover:bg-mercury/5"
        >
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
          New chat
        </button>
        <ul id="chat-session-list" class="flex min-h-0 flex-1 flex-col gap-0.5 overflow-y-auto">
          <li class="px-3 py-2 font-body text-sm text-mercury/40">Loading…</li>
        </ul>
      </aside>

      <section class="glass-card flex min-h-0 min-w-0 flex-1 flex-col overflow-hidden">
        <ul id="chat-thread" class="flex min-h-0 flex-1 flex-col gap-5 overflow-y-auto px-6 py-6">
          <li class="mx-auto max-w-md py-12 text-center font-body text-sm text-mercury/50">
            Ask it to check the pipeline status, preview a settings change, or trigger a run.
          </li>
        </ul>

        <div class="p-4 pt-0">
          <PromptInputBox client:load />
        </div>
      </section>
    </div>
  </main>

  <script>
    import { initChat, sendComposerMessage } from "../../console/scripts/chat.ts";
    initChat();

    // Bridge for the PromptInputBox React island (src/console/components/
    // PromptInputBox.tsx) — it can't take a function prop across the Astro
    // island boundary, so it dispatches this event instead; the busy state
    // flows back the same way so its send button/textarea disable correctly.
    window.addEventListener("chat:send", (event) => {
      const { content } = (event as CustomEvent<{ content: string }>).detail;
      void sendComposerMessage(content, (busy) => {
        window.dispatchEvent(new CustomEvent("chat:busy", { detail: { busy } }));
      });
    });
  </script>
</ConsoleLayout>
