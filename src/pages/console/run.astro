---
// The guided run (plan v2 §7): all five steps. 1-3 are the plan form (how
// many videos, a topic each, a ranked idea each), 4 is the waiting screen,
// 5 is review and download.
//
// Structural shell only, like every other console page: output: "static"
// means every value below is filled in at runtime — the plan form by
// src/console/scripts/run-plan-wizard.ts, the run view by run-flow.ts, both
// against the real /console/* API.
import ConsoleLayout from "../../layouts/ConsoleLayout.astro";
import ConsoleShell from "../../console/components/ConsoleShell.astro";

const steps: { n: number; label: string; caption: string }[] = [
  { n: 1, label: "How many", caption: "videos this run" },
  { n: 2, label: "Topics", caption: "one per video" },
  { n: 3, label: "Ideas", caption: "ranked, you pick" },
  { n: 4, label: "The work", caption: "agents run" },
  { n: 5, label: "Review", caption: "watch, download" },
];

// Mirrors MAX_VIDEOS_PER_PLAN in src/server/console/run-plan.ts. Rendered
// server-side rather than built in the wizard so the control exists before
// any JS runs — the count is the one decision the whole form hangs off.
const counts = [1, 2, 3, 4, 5, 6];
---

<ConsoleLayout title="Run">
  <ConsoleShell active="run" />

  <main class="mx-auto max-w-5xl px-6 pb-16">
    <ol class="mb-6 grid grid-cols-2 gap-2 sm:grid-cols-5">
      {
        steps.map((step) => (
          <li
            data-step={String(step.n)}
            aria-current="false"
            class="glass-card flex flex-col gap-0.5 border border-mercury/15 px-3 py-2.5 text-mercury/45 transition-colors"
          >
            <span class="font-mono text-[0.65rem] uppercase tracking-wide">{step.n}</span>
            <span class="font-display text-sm font-semibold leading-tight">{step.label}</span>
            <span class="font-body text-[0.7rem] leading-tight opacity-80">{step.caption}</span>
          </li>
        ))
      }
    </ol>

    <!-- Steps 1-3 -->
    <section class="glass-card gradient-accent-border mb-6 flex flex-col gap-4 p-5">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <div class="flex flex-col gap-0.5">
          <h2 class="font-display text-sm font-semibold text-mercury">Plan a run</h2>
          <p class="font-body text-xs text-mercury/50">How many videos, what each one is about, and which story it takes.</p>
        </div>
        <div class="flex flex-wrap items-center gap-1.5">
          {
            counts.map((count) => (
              <button
                type="button"
                data-video-count={String(count)}
                aria-pressed="false"
                class="h-8 w-8 rounded-full border border-mercury/20 font-mono text-xs text-mercury/60 transition-colors hover:border-mercury/40 hover:text-mercury"
              >
                {count}
              </button>
            ))
          }
        </div>
      </div>

      <div id="plan-slots-section" hidden class="flex flex-col gap-4">
        <ul id="plan-slots" class="grid grid-cols-1 gap-3 lg:grid-cols-2"></ul>
        <div class="flex flex-wrap items-center justify-between gap-3">
          <p id="plan-status" hidden class="font-body text-xs leading-relaxed"></p>
          <button
            type="button"
            id="plan-submit"
            disabled
            class="ml-auto rounded-full border border-sodium/40 px-4 py-1.5 font-body text-xs text-sodium transition-colors hover:bg-sodium/10 disabled:cursor-not-allowed disabled:border-mercury/15 disabled:text-mercury/35"
          >
            Queue videos
          </button>
        </div>
      </div>

      <div class="flex flex-col gap-2 border-t border-mercury/10 pt-4">
        <h3 class="font-mono text-[0.65rem] uppercase tracking-wide text-mercury/45">Queued</h3>
        <p id="plan-queue-empty" hidden class="font-body text-xs text-mercury/45">
          Nothing queued. Without a queued pick, a scheduled RENDER chooses its own story by diversity weighting.
        </p>
        <ul id="plan-queue" class="flex flex-col gap-2"></ul>
      </div>
    </section>

    <!-- Steps 4 and 5 -->
    <section class="glass-card gradient-accent-border mb-6 flex flex-col gap-4 p-5">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <div class="flex min-w-0 flex-wrap items-center gap-3">
          <span id="run-status" class="inline-flex items-center rounded-full border border-mercury/25 px-3 py-1 font-mono text-xs uppercase tracking-wide text-mercury/60">
            Loading
          </span>
          <span id="run-started" class="font-mono text-xs text-mercury/50"></span>
        </div>
        <div class="flex items-center gap-2">
          <label class="sr-only" for="run-picker">Run</label>
          <select
            id="run-picker"
            class="max-w-[16rem] truncate rounded-full border border-mercury/20 bg-transparent px-3.5 py-1.5 font-body text-xs text-mercury/80"
          >
            <option value="">Loading runs…</option>
          </select>
          <button
            type="button"
            id="run-start"
            class="rounded-full border border-mercury/20 px-3.5 py-1.5 font-body text-xs text-mercury/70 transition-colors hover:border-sodium/50 hover:text-sodium"
          >
            Start a run
          </button>
        </div>
      </div>

      <ul id="run-stages" class="flex flex-wrap gap-x-5 gap-y-2">
        <li class="font-body text-xs text-mercury/50">Loading…</li>
      </ul>

      <p id="run-note" hidden class="font-body text-xs leading-relaxed text-mercury/60"></p>
    </section>

    <p id="run-videos-empty" hidden class="mb-4 font-body text-sm text-mercury/50"></p>
    <div id="run-videos" class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3"></div>

    <!--
      Said once, on the page, not per card: the montage is stock footage
      standing in for the idea while the run works. The video itself is cut
      from the maintained, provenance-tracked library (CLAUDE.md), and
      nothing shown here can enter it.
    -->
    <p class="mt-6 font-body text-xs leading-relaxed text-mercury/45">
      Preview clips come from <a href="https://www.pexels.com" class="underline decoration-mercury/30 underline-offset-2">Pexels</a>, searched for each script's
      own keywords. They illustrate the idea while the run works — the rendered video's footage always comes from the maintained library.
    </p>
  </main>

  <script>
    import { initRunFlow, refreshRunView } from "../../console/scripts/run-flow.ts";
    import { initRunPlanWizard } from "../../console/scripts/run-plan-wizard.ts";

    initRunFlow();
    // Queueing a plan changes what the next run will build, so the run view
    // re-reads rather than waiting out its poll interval.
    initRunPlanWizard(() => void refreshRunView());
  </script>
</ConsoleLayout>
