---
// Voice control — a separate section from the text /console/chat, per the
// operator's explicit request. Speech-to-text via Groq Whisper
// (POST /console/voice/transcribe), tool calls dispatched through the MCP
// tool contract (POST /console/voice/turn -> src/server/mcp/server.ts),
// spoken replies via the browser's own SpeechSynthesis — not the Edge TTS
// driver, which shells out to a Python subprocess a Cloudflare Worker
// cannot run (docs/DECISIONS.md's MCP-as-runtime-integration ADR).
// Static shell only, same output: "static" constraint as every other
// console page — src/console/scripts/voice.ts drives it at runtime.
import ConsoleLayout from "../../layouts/ConsoleLayout.astro";
import ConsoleShell from "../../console/components/ConsoleShell.astro";
---

<ConsoleLayout title="Voice">
  <ConsoleShell active="voice" />

  <main class="mx-auto flex h-[calc(100vh-5.5rem)] max-w-3xl flex-col gap-4 px-6 pb-6">
    <section class="glass-card flex min-h-0 flex-1 flex-col overflow-hidden bg-ink">
      <ul id="voice-thread" class="relative flex min-h-0 flex-1 flex-col gap-5 overflow-y-auto px-6 py-6">
        <li class="mx-auto max-w-md py-12 text-center font-body text-sm text-mercury/50">
          Hold the orb and ask it to check the pipeline status, preview a settings change, or trigger a run.
        </li>
      </ul>

      <div class="relative flex flex-col items-center gap-4 p-8 pt-0">
        <!-- Idle: the Siri Orb (21st.dev, see global.css) is the button itself.
             Recording: the orb fades out, the Siri Wave canvas (siri-wave.ts)
             fades in over the same footprint — both share a pure-black backing
             (tokens.css --ink/--slate) so neither reads as a box pasted onto
             the page. voice.ts toggles [data-recording] on this wrapper. -->
        <div id="voice-stage" class="relative flex h-28 w-full max-w-md items-center justify-center">
          <canvas
            id="voice-wave"
            class="pointer-events-none absolute inset-x-0 top-1/2 h-28 w-full -translate-y-1/2 opacity-0 transition-opacity duration-500"
            aria-hidden="true"></canvas>
          <button
            type="button"
            id="voice-record-button"
            aria-label="Hold to talk"
            class="siri-orb relative h-20 w-20 shrink-0 border-0 transition-[opacity,transform] duration-300 active:scale-95 disabled:opacity-40"
          ></button>
        </div>
        <p id="voice-status" data-field class="font-body text-xs text-mercury/50">Hold the orb and speak</p>
      </div>
    </section>
  </main>

  <script>
    import { initVoice } from "../../console/scripts/voice.ts";
    initVoice();
  </script>
</ConsoleLayout>
