---
// Pipeline settings composer (CONSOLE_SPEC.md §3). Static shell — real
// current values are loaded and the form populated by
// src/console/scripts/settings-form.ts at runtime (see index.astro's
// header comment on output: "static"). Dry run is mandatory before
// Activate unlocks, matching the documented flow exactly.
import ConsoleLayout from "../../layouts/ConsoleLayout.astro";
import ConsoleShell from "../../console/components/ConsoleShell.astro";
import { DEFAULT_VOICE_POOL } from "../../config/voices.ts";
---

<ConsoleLayout title="Settings">
  <ConsoleShell active="settings" />

  <main class="mx-auto max-w-3xl px-6 pb-16">
    <div id="console-api-error" data-console-api-error class="glass-card mb-6 hidden p-4 font-mono text-xs text-rose">
      Console API not reachable — Phase 8's Worker routes aren't wired up yet.
    </div>

    <form id="settings-form" class="glass-card flex flex-col gap-6 p-6">
      <div class="flex flex-col gap-1">
        <label for="focus-games" class="font-mono text-xs uppercase tracking-wide text-mercury/70">
          Focus games <span class="text-mercury/40">(comma-separated, up to 10 — empty = all)</span>
        </label>
        <input
          id="focus-games"
          name="focusGames"
          type="text"
          class="rounded-md border border-mercury/20 bg-transparent px-3 py-2 font-mono text-sm text-mercury focus-visible:outline-2 focus-visible:outline-sodium"
          placeholder="minecraft, gta-v"
        />
      </div>

      <div class="flex flex-col gap-1">
        <label for="exclude-topics" class="font-mono text-xs uppercase tracking-wide text-mercury/70">
          Exclude topics <span class="text-mercury/40">(comma-separated, up to 25)</span>
        </label>
        <input
          id="exclude-topics"
          name="excludeTopics"
          type="text"
          class="rounded-md border border-mercury/20 bg-transparent px-3 py-2 font-mono text-sm text-mercury focus-visible:outline-2 focus-visible:outline-sodium"
        />
      </div>

      <div class="flex flex-col gap-1">
        <label for="preferred-sources" class="font-mono text-xs uppercase tracking-wide text-mercury/70">
          Preferred source ids <span class="text-mercury/40">(comma-separated, up to 10)</span>
        </label>
        <input
          id="preferred-sources"
          name="preferredSourceIds"
          type="text"
          class="rounded-md border border-mercury/20 bg-transparent px-3 py-2 font-mono text-sm text-mercury focus-visible:outline-2 focus-visible:outline-sodium"
        />
      </div>

      <div class="grid grid-cols-2 gap-4">
        <div class="flex flex-col gap-1">
          <label for="min-originality" class="font-mono text-xs uppercase tracking-wide text-mercury/70">
            Min originality score (advisory)
          </label>
          <input
            id="min-originality"
            name="minOriginalityScore"
            type="number"
            min="0"
            max="1"
            step="0.05"
            class="rounded-md border border-mercury/20 bg-transparent px-3 py-2 font-mono text-sm text-mercury focus-visible:outline-2 focus-visible:outline-sodium"
          />
        </div>
        <div class="flex flex-col gap-1">
          <label for="max-uploads" class="font-mono text-xs uppercase tracking-wide text-mercury/70"> Max exports / day </label>
          <input
            id="max-uploads"
            name="maxUploadsPerDay"
            type="number"
            min="1"
            max="6"
            step="1"
            class="rounded-md border border-mercury/20 bg-transparent px-3 py-2 font-mono text-sm text-mercury focus-visible:outline-2 focus-visible:outline-sodium"
          />
        </div>
      </div>

      <div class="flex flex-col gap-1">
        <label for="tone" class="font-mono text-xs uppercase tracking-wide text-mercury/70">Tone</label>
        <select
          id="tone"
          name="tone"
          class="rounded-md border border-mercury/20 bg-ink px-3 py-2 font-mono text-sm text-mercury focus-visible:outline-2 focus-visible:outline-sodium"
        >
          <option value="">unset</option>
          <option value="neutral">neutral</option>
          <option value="provocative">provocative</option>
          <option value="analytical">analytical</option>
        </select>
      </div>

      <div class="flex flex-col gap-1">
        <label for="editorial-note" class="font-mono text-xs uppercase tracking-wide text-mercury/70">
          Editorial note <span class="text-mercury/40">(max 280 chars — the only free text a prompt ever sees)</span>
        </label>
        <textarea
          id="editorial-note"
          name="editorialNote"
          maxlength="280"
          rows="3"
          class="rounded-md border border-mercury/20 bg-transparent px-3 py-2 font-mono text-sm text-mercury focus-visible:outline-2 focus-visible:outline-sodium"
        ></textarea>
      </div>

      <fieldset class="flex flex-col gap-2">
        <legend class="font-mono text-xs uppercase tracking-wide text-mercury/70">
          Voice pool <span class="text-mercury/40">(none selected = full default pool)</span>
        </legend>
        <div class="grid grid-cols-2 gap-2 sm:grid-cols-3">
          {
            DEFAULT_VOICE_POOL.map((voice) => (
              <label class="flex items-center gap-2 font-mono text-xs text-mercury/80">
                <input type="checkbox" name="voicePool" value={voice} class="accent-sodium" />
                {voice}
              </label>
            ))
          }
        </div>
      </fieldset>

      <div class="grid grid-cols-2 gap-4">
        <div class="flex flex-col gap-1">
          <label for="rate-min" class="font-mono text-xs uppercase tracking-wide text-mercury/70">
            Rate range min <span class="text-mercury/40">e.g. -10%</span>
          </label>
          <input
            id="rate-min"
            name="ttsRateMin"
            type="text"
            placeholder="fixed +0%"
            class="rounded-md border border-mercury/20 bg-transparent px-3 py-2 font-mono text-sm text-mercury focus-visible:outline-2 focus-visible:outline-sodium"
          />
        </div>
        <div class="flex flex-col gap-1">
          <label for="rate-max" class="font-mono text-xs uppercase tracking-wide text-mercury/70">
            Rate range max <span class="text-mercury/40">e.g. +15%</span>
          </label>
          <input
            id="rate-max"
            name="ttsRateMax"
            type="text"
            placeholder="fixed +0%"
            class="rounded-md border border-mercury/20 bg-transparent px-3 py-2 font-mono text-sm text-mercury focus-visible:outline-2 focus-visible:outline-sodium"
          />
        </div>
      </div>

      <label class="flex items-center gap-3 font-mono text-xs uppercase tracking-wide text-mercury/70">
        <input type="checkbox" id="diversity-mode" name="diversityMode" class="accent-sodium" checked />
        Diversity mode — spread today's picks across games/sources/voices
      </label>

      <div id="validation-errors" class="hidden font-mono text-xs text-rose"></div>

      <div id="dry-run-result" class="hidden rounded-md border border-mercury/15 p-3 font-mono text-xs text-mercury/70"></div>

      <div class="flex flex-wrap items-center gap-3 border-t border-mercury/10 pt-4">
        <button
          type="button"
          id="dry-run-button"
          class="rounded-md border border-mercury/30 px-4 py-2 font-mono text-xs uppercase tracking-wide text-mercury hover:border-sodium/60 hover:text-sodium"
        >
          Dry run
        </button>
        <button
          type="submit"
          id="activate-button"
          disabled
          class="rounded-md border border-sodium/40 px-4 py-2 font-mono text-xs uppercase tracking-wide text-sodium transition-opacity hover:bg-sodium/10 disabled:cursor-not-allowed disabled:opacity-40"
        >
          Activate
        </button>
        <button
          type="button"
          id="reset-defaults-button"
          class="ml-auto rounded-md border border-mercury/20 px-4 py-2 font-mono text-xs uppercase tracking-wide text-mercury/70 hover:border-mercury/40"
        >
          Reset to defaults
        </button>
      </div>
      <p id="settings-status" class="font-mono text-xs text-mercury/50" role="status"></p>
    </form>
  </main>

  <script>
    import { initSettingsForm } from "../../console/scripts/settings-form.ts";
    initSettingsForm();
  </script>
</ConsoleLayout>
