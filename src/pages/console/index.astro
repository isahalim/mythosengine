---
// Bento dashboard (CONSOLE_SPEC.md §4). output: "static" (astro.config.mjs)
// means this page is prerendered — it ships structural chrome only. Every
// number/status here is filled in at runtime by src/console/scripts/dashboard.ts
// calling the same-origin /console/* API (Phase 8), never baked in at build
// time. Until that API exists, cards honestly show their loading/error
// state — no fabricated data (CLAUDE.md NEVER block).
import ConsoleLayout from "../../layouts/ConsoleLayout.astro";
import ConsoleShell from "../../console/components/ConsoleShell.astro";
import BentoCard from "../../console/components/BentoCard.astro";
import QuotaMeter from "../../console/components/QuotaMeter.astro";
---

<ConsoleLayout title="Dashboard">
  <ConsoleShell active="dashboard" />

  <main class="mx-auto max-w-6xl px-6 pb-16">
    <div id="console-api-error" data-console-api-error class="glass-alert mb-6 hidden">
      Console API not reachable.
    </div>

    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4 lg:auto-rows-[minmax(160px,auto)]">
      <BentoCard title="Pipeline pulse" size="wide">
        <Fragment slot="badge">
          <span id="pulse-live-stage" data-field class="font-mono text-xs text-sodium"></span>
        </Fragment>
        <div class="grid grid-cols-4 gap-3 font-mono text-xs">
          <div><p id="pulse-signals" data-field class="text-2xl text-bone">–</p><p class="text-mercury/50">signals</p></div>
          <div><p id="pulse-scripted" data-field class="text-2xl text-bone">–</p><p class="text-mercury/50">scripted</p></div>
          <div><p id="pulse-rendered" data-field class="text-2xl text-bone">–</p><p class="text-mercury/50">rendered</p></div>
          <div><p id="pulse-exported" data-field class="text-2xl text-bone">–</p><p class="text-mercury/50">exported</p></div>
        </div>
        <div class="mt-3 flex items-center justify-between gap-3">
          <p class="font-mono text-xs text-mercury/50">
            next run <span id="pulse-next-cron" data-field>–</span>
          </p>
          <button
            type="button"
            id="dispatch-run-button"
            data-field
            class="rounded-full border border-mercury/20 px-3.5 py-1.5 font-body text-xs text-mercury/70 transition-colors hover:border-sodium/50 hover:text-sodium"
          >
            Run now
          </button>
        </div>
      </BentoCard>

      <BentoCard title="Ready for review" size="tall" href="/console/review">
        <Fragment slot="badge">
          <span id="ready-count" data-field class="rounded-full bg-sodium/15 px-2 py-0.5 font-mono text-xs text-sodium">–</span>
        </Fragment>
        <ul id="ready-preview" data-field class="flex flex-col gap-2 font-mono text-xs text-mercury/70">
          <li>Loading…</li>
        </ul>
      </BentoCard>

      <BentoCard title="Reviewed" size="tall">
        <ul id="reviewed-preview" data-field class="flex flex-col gap-2 font-mono text-xs text-mercury/70">
          <li>Loading…</li>
        </ul>
      </BentoCard>

      <BentoCard title="Audit flags" size="md">
        <p class="mb-2 text-xs text-mercury/50">last 7 days · informational, never blocking</p>
        <ul id="audit-flags" data-field class="flex flex-col gap-2 font-mono text-xs text-mercury/70">
          <li>Loading…</li>
        </ul>
      </BentoCard>

      <BentoCard title="Footage health" size="md">
        <ul id="footage-health" data-field class="flex flex-col gap-2 font-mono text-xs text-mercury/70">
          <li>Loading…</li>
        </ul>
      </BentoCard>

      <BentoCard title="Quota" size="sm">
        <div class="flex flex-col gap-3">
          <QuotaMeter id="quota-groq" label="Groq requests" used={0} ceiling={1} />
          <QuotaMeter id="quota-youtube" label="YouTube units" used={0} ceiling={1} />
          <QuotaMeter id="quota-actions" label="Actions minutes" used={0} ceiling={1} />
          <QuotaMeter id="quota-kv" label="KV storage" used={0} ceiling={1} />
        </div>
      </BentoCard>

      <BentoCard title="TTS status" size="sm" accent>
        <p class="mb-2 text-xs text-mercury/50">the one card that matters most operationally</p>
        <span id="tts-status-dot" data-field class="font-mono text-xs text-mercury/60">checking…</span>
      </BentoCard>

      <BentoCard title="Pipeline settings" size="md" href="/console/settings">
        <div id="settings-summary" data-field class="font-mono text-xs text-mercury/60">Loading…</div>
      </BentoCard>

      <BentoCard title="Keys" size="lg">
        <ul id="key-list" data-field class="flex flex-col"></ul>
      </BentoCard>

      <BentoCard title="Killswitch" size="sm">
        <button
          type="button"
          id="killswitch-toggle"
          data-field
          aria-pressed="false"
          class="w-full rounded-xl border border-rose/40 px-4 py-3 font-body text-sm text-rose transition-colors hover:bg-rose/10"
        >
          Halt pipeline
        </button>
      </BentoCard>
    </div>
  </main>

  <script>
    import { initDashboard } from "../../console/scripts/dashboard.ts";
    initDashboard();
  </script>
</ConsoleLayout>
