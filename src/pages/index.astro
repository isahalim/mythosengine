---
// The whole product. One route, client-rendered: the six-stage surface is
// a single continuous experience (the glass never remounts between
// stages), so there is nothing for Astro to route between and no HTML
// worth pre-rendering behind a passkey gate.
//
// noindex is deliberate: everything past the landing is operator-only, and
// src/index.ts sets X-Robots-Tag to match at the header level.
import "@fontsource/bricolage-grotesque/400.css";
import "@fontsource/bricolage-grotesque/600.css";
import "@fontsource/bricolage-grotesque/700.css";
import "@fontsource/public-sans/400.css";
import "@fontsource/public-sans/500.css";
import "@fontsource/jetbrains-mono/400.css";
import "../styles/global.css";
import App from "../app/App.tsx";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#ffffff" />
    <title>Mythos Engine — shatter into reality.</title>
    <link rel="icon" href="data:," />
    <!-- The pane is gated on this having decoded, so it is worth asking
         for before the bundle has finished parsing. -->
    <link rel="preload" as="image" href="/shards/atlas-desktop.png" />
  </head>
  <body>
    <App client:only="react" />
  </body>
</html>
