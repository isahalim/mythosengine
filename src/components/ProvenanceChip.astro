---
// Renders the provenance strip: the site's editorial claim, generated from
// trust-tier data. See ARCHITECTURE.md §8 — this is the site's second
// signature element, not decoration.
interface Props {
  tier: 1 | 2 | 3;
  label: "OFFICIAL" | "REPORTED" | "UNVERIFIED";
}

const { tier, label } = Astro.props;
const color = tier === 1 ? "text-oxide border-oxide" : "text-sodium border-sodium";
---

<span
  class:list={[
    "inline-flex items-center gap-2 rounded-full border px-3 py-1 font-mono text-xs uppercase tracking-wider",
    color,
  ]}
>
  TIER {tier} · {label}
</span>
