---
// Two-tier hero (docs/DECISIONS.md, 2026-08-28): the SVG below is tier 1,
// always in the HTML, the only thing a crawler, a screen reader, or a
// browser with WebGL disabled ever sees. src/scripts/hero-orb.ts is tier 2
// — the real @paper-design/shaders "Liquid Metal" shader mounted over it
// (the shader appends its own <canvas> into #hero-orb-mount); it silently
// declines to mount at all under prefers-reduced-motion, no WebGL2, or a
// failed context. This lives on the public homepage only —
// CONSOLE_SPEC.md's bundle budget and "no hero" call for /console/* are
// unchanged; this is a separate bundle, its own size-limit entry in
// package.json.
---

<div class="relative mx-auto aspect-square w-full">
  <svg
    viewBox="0 0 400 400"
    role="img"
    aria-label="A bead of liquid metal resting on a dark surface"
    class="absolute inset-0 h-full w-full"
  >
    <defs>
      <radialGradient id="bead" cx="35%" cy="30%" r="70%">
        <stop offset="0%" stop-color="var(--bone)" />
        <stop offset="35%" stop-color="var(--mercury)" />
        <stop offset="75%" stop-color="var(--slate)" />
        <stop offset="100%" stop-color="var(--ink)" />
      </radialGradient>
      <radialGradient id="glow" cx="50%" cy="85%" r="60%">
        <stop offset="0%" stop-color="var(--sodium)" stop-opacity="0.25" />
        <stop offset="100%" stop-color="var(--sodium)" stop-opacity="0" />
      </radialGradient>
    </defs>
    <ellipse cx="200" cy="330" rx="150" ry="24" fill="url(#glow)" />
    <circle cx="200" cy="190" r="130" fill="url(#bead)" />
    <path
      d="M 110 150 Q 200 120 290 160 Q 230 200 200 260 Q 160 200 110 150 Z"
      fill="var(--ink)"
      opacity="0.35"
    />
  </svg>
  <div id="hero-orb-mount" class="absolute inset-0 h-full w-full overflow-hidden rounded-full" aria-hidden="true"></div>
</div>

<script>
  import { initHeroOrb } from "../scripts/hero-orb.ts";
  const mount = document.getElementById("hero-orb-mount");
  if (mount) initHeroOrb(mount);
</script>
