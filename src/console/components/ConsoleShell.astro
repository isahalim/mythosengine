---
interface Props {
  active: "dashboard" | "review" | "settings" | "chat";
}

const { active } = Astro.props;

const links: { href: string; label: string; key: Props["active"] }[] = [
  { href: "/console", label: "Dashboard", key: "dashboard" },
  { href: "/console/review", label: "Review queue", key: "review" },
  { href: "/console/chat", label: "Chat", key: "chat" },
  { href: "/console/settings", label: "Settings", key: "settings" },
];
---

<header class="mx-auto flex max-w-6xl flex-col gap-4 px-6 py-6 sm:flex-row sm:items-center sm:justify-between">
  <div class="flex items-center gap-6">
    <span class="font-mono text-sm uppercase tracking-[0.2em] text-mercury">AutoShorts AI · Console</span>
    <nav class="flex items-center gap-4 font-mono text-xs uppercase tracking-wide">
      {
        links.map((link) => (
          <a
            href={link.href}
            aria-current={active === link.key ? "page" : undefined}
            class:list={[
              "transition-colors",
              active === link.key ? "text-sodium" : "text-mercury/60 hover:text-mercury",
            ]}
          >
            {link.label}
          </a>
        ))
      }
    </nav>
  </div>
  <div class="flex items-center gap-4">
    <div id="killswitch-banner" data-killswitch-banner class="hidden font-mono text-xs uppercase tracking-wide text-rose">
      Pipeline halted
    </div>
    <button
      id="console-logout-button"
      type="button"
      class="font-mono text-xs uppercase tracking-wide text-mercury/50 hover:text-rose"
    >
      Sign out
    </button>
  </div>
</header>

<script>
  import { logout } from "../lib/api.ts";
  document.getElementById("console-logout-button")?.addEventListener("click", () => {
    void logout().then(() => {
      window.location.href = "/console/login";
    });
  });
</script>
