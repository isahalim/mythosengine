---
// Restyled 2026-08-28 (later, docs/DECISIONS.md) away from the all-caps
// mono nav every earlier console page inherited — this shell is shared by
// every page here, so it's the single highest-leverage place to move the
// console's whole feel toward the login/homepage's sans-serif, glassy look.
interface Props {
  active: "dashboard" | "review" | "settings" | "chat";
}

const { active } = Astro.props;

const links: { href: string; label: string; key: Props["active"] }[] = [
  { href: "/console", label: "Dashboard", key: "dashboard" },
  { href: "/console/review", label: "Review queue", key: "review" },
  { href: "/console/chat", label: "Chat", key: "chat" },
  { href: "/console/settings", label: "Settings", key: "settings" },
];
---

<header class="glass-card sticky top-4 z-30 mx-auto mb-6 mt-4 flex max-w-6xl items-center justify-between gap-3 px-4 py-3 sm:px-5">
  <div class="flex min-w-0 items-center gap-4">
    <span class="shrink-0 font-display text-sm font-semibold tracking-tight text-bone">AutoShorts AI</span>
    <nav class="flex items-center gap-1 overflow-x-auto font-body text-sm [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
      {
        links.map((link) => (
          <a
            href={link.href}
            aria-current={active === link.key ? "page" : undefined}
            class:list={[
              "shrink-0 whitespace-nowrap rounded-full px-3 py-1.5 transition-colors",
              active === link.key ? "bg-mercury/10 text-bone" : "text-mercury/60 hover:text-bone",
            ]}
          >
            {link.label}
          </a>
        ))
      }
    </nav>
  </div>
  <div class="flex shrink-0 items-center gap-2">
    <div id="killswitch-banner" data-killswitch-banner class="hidden items-center gap-1.5 rounded-full bg-rose/10 px-3 py-1 font-body text-xs text-rose">
      Pipeline halted
    </div>
    <button
      id="console-logout-button"
      type="button"
      class="rounded-full px-3 py-1.5 font-body text-xs text-mercury/50 transition-colors hover:bg-rose/10 hover:text-rose"
    >
      Sign out
    </button>
  </div>
</header>

<script>
  import { logout } from "../lib/api.ts";
  document.getElementById("console-logout-button")?.addEventListener("click", () => {
    void logout().then(() => {
      window.location.href = "/console/login";
    });
  });
</script>
