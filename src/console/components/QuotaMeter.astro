---
interface Props {
  id: string;
  label: string;
  used: number;
  ceiling: number;
}

const { id, label, used, ceiling } = Astro.props;
const pct = ceiling > 0 ? Math.min(100, Math.round((used / ceiling) * 100)) : 0;
---

<div class="flex flex-col gap-1" data-quota-meter={id}>
  <div class="flex items-baseline justify-between font-mono text-xs text-mercury/70">
    <span>{label}</span>
    <span id={`${id}-text`}>{used} / {ceiling}</span>
  </div>
  <div class="h-1.5 w-full overflow-hidden rounded-full bg-mercury/10">
    <div id={`${id}-fill`} class="h-full rounded-full" style={`width:${pct}%;background:var(--gradient-accent)`}></div>
  </div>
</div>
