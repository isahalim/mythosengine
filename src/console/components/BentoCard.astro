---
// Base glass card for the bento dashboard (CONSOLE_SPEC.md §4). Pure Astro,
// no framework — matches src/components/HeroBead.astro's existing pattern.
interface Props {
  title: string;
  size?: "sm" | "md" | "lg" | "wide" | "tall";
  href?: string;
  accent?: boolean;
}

const { title, size = "md", href, accent = false } = Astro.props;

const sizeClasses: Record<NonNullable<Props["size"]>, string> = {
  sm: "lg:col-span-1 lg:row-span-1",
  md: "lg:col-span-1 lg:row-span-1",
  lg: "lg:col-span-2 lg:row-span-1",
  wide: "lg:col-span-2 lg:row-span-1",
  tall: "lg:col-span-1 lg:row-span-2",
};

const Tag = href ? "a" : "div";
---

<Tag
  href={href}
  class:list={[
    "glass-card gradient-accent-border flex min-h-[140px] flex-col gap-3 p-5",
    sizeClasses[size],
    href && "transition-colors hover:border-mercury/30 focus-visible:outline-2 focus-visible:outline-sodium",
    accent && "ring-1 ring-violet/20",
  ]}
>
  <div class="flex items-center justify-between gap-2">
    <h3 class="font-display text-sm font-semibold uppercase tracking-wide text-mercury/80">
      {title}
    </h3>
    <slot name="badge" />
  </div>
  <div class="flex-1 font-body text-sm text-mercury">
    <slot />
  </div>
</Tag>
