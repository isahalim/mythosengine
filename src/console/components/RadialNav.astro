---
// Radial nav, adapted from 21st.dev's "Radial Orbital Timeline"
// (jatin-yadav05, id 1820 — https://21st.dev/@jatin-yadav05/components/radial-orbital-timeline).
// The source component is a full-screen, React/Radix-based timeline
// visualization with expandable content cards per node — this project has
// no React/Radix anywhere (CONSOLE_SPEC.md §5: presentation only, rewrite
// everything else). What's reused is the mechanic: N nodes arranged around
// a center point at angle = (index/total)*360 + rotation, auto-rotating,
// hand-ported to vanilla Astro + src/console/scripts/radial-nav.ts.
//
// Two states, per the operator's explicit spec (docs/DECISIONS.md):
// - Expanded: full-viewport. Shown by default only on the very first
//   dashboard view right after signing in — login.ts sets a one-shot
//   sessionStorage flag before its redirect, radial-nav.ts consumes it on
//   init. Always server-rendering this expanded on every /console visit
//   (the original implementation) meant clicking the Dashboard nav node
//   from anywhere else re-triggered the full-viewport takeover instead of
//   showing the actual bento dashboard underneath it — fixed by moving the
//   decision to that one-shot flag instead of `active === "dashboard"`.
//   Clicking a section node navigates immediately (a real page load — see
//   radial-nav.ts). Clicking empty space collapses without navigating.
// - Collapsed: the compact 92px header widget from the original build.
//   Clicking the center (the Liquid Metal shader, src/shaders/liquid-metal.ts)
//   expands back to full-viewport, in place, no navigation.
//
// Desktop-only (md: and up) — ConsoleShell.astro keeps the flat pill nav
// for narrow viewports, where an orbital layout has no reasonable room.
interface Props {
  active: "dashboard" | "review" | "settings" | "chat" | "voice";
}

const { active } = Astro.props;

const nodes: { href: string; label: string; key: Props["active"] }[] = [
  { href: "/console", label: "Dashboard", key: "dashboard" },
  { href: "/console/review", label: "Review", key: "review" },
  { href: "/console/chat", label: "Chat", key: "chat" },
  { href: "/console/voice", label: "Voice", key: "voice" },
  { href: "/console/settings", label: "Settings", key: "settings" },
];

// Hand-drawn inline SVG paths — no icon library dependency anywhere in this
// project (src/console/scripts/chat.ts's closeIcon() sets the precedent).
const ICON_PATHS: Record<Props["active"], string> = {
  dashboard: "M4 4h7v7H4zM13 4h7v4h-7zM13 11h7v9h-7zM4 14h7v6H4z",
  review: "M5 6h14M5 12h14M5 18h9",
  chat: "M4 5h16v11H8l-4 4z",
  voice: "M12 3a3 3 0 0 0-3 3v6a3 3 0 0 0 6 0V6a3 3 0 0 0-3-3zM6 11a6 6 0 0 0 12 0M12 18v3",
  settings: "M12 9a3 3 0 1 0 0 6 3 3 0 0 0 0-6zM19 12a7 7 0 0 0-.1-1.2l2-1.5-2-3.4-2.3.9a7 7 0 0 0-2-1.2L14 3h-4l-.6 2.5a7 7 0 0 0-2 1.2l-2.3-.9-2 3.4 2 1.5A7 7 0 0 0 5 12c0 .4 0 .8.1 1.2l-2 1.5 2 3.4 2.3-.9c.6.5 1.3.9 2 1.2L10 21h4l.6-2.5c.7-.3 1.4-.7 2-1.2l2.3.9 2-3.4-2-1.5c.1-.4.1-.8.1-1.2z",
};
---

<div
  id="radial-nav-backdrop"
  class="pointer-events-none fixed inset-0 z-40 hidden bg-ink opacity-0 transition-opacity duration-300 md:block"
  aria-hidden="true"
>
</div>

<nav
  id="radial-nav"
  class="radial-nav--collapsed z-50 hidden shrink-0 items-center justify-center md:flex"
  aria-label="Console sections"
  data-active={active}
  data-expanded="false"
>
  <div class="radial-nav-ring pointer-events-none absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 rounded-full border border-mercury/15"></div>
  <button
    type="button"
    id="radial-nav-center"
    aria-label="Show all sections"
    class="radial-nav-center pointer-events-auto absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 overflow-hidden rounded-full border-0 bg-gradient-to-br from-oxide via-sodium to-violet"
  ></button>

  {
    nodes.map((node) => (
      <a
        href={node.href}
        aria-current={active === node.key ? "page" : undefined}
        data-radial-node={node.key}
        title={node.label}
        class:list={[
          "radial-node absolute left-1/2 top-1/2 flex -translate-x-1/2 -translate-y-1/2 flex-col items-center justify-center gap-1.5 rounded-full border transition-colors",
          active === node.key
            ? "border-sodium bg-sodium/20 text-sodium"
            : "border-mercury/30 bg-ink text-mercury/70 hover:border-mercury/60 hover:text-bone",
        ]}
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d={ICON_PATHS[node.key]} stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        <span class="radial-node-label whitespace-nowrap font-body text-xs">{node.label}</span>
      </a>
    ))
  }
</nav>

<script>
  import { initRadialNav } from "../scripts/radial-nav.ts";
  initRadialNav();
</script>
