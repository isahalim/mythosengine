{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": ["src/pages/**/*.astro", "scripts/*.mjs", "src/lib/drivers/*.ts", "src/lib/ingest/*.ts", "src/lib/footage/*.ts", "config/*.ts", "db/*.ts"],
  "project": ["src/**/*.{ts,tsx,astro}", "scripts/**/*.mjs", "config/**/*.ts", "db/**/*.ts"],
  "ignoreDependencies": ["tailwindcss"],
  "ignoreBinaries": ["ffmpeg", "ffprobe"]
}
